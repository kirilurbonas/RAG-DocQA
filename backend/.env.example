# Backend Storage Configuration
# Choose storage backend: "database" (SQLite/PostgreSQL/MySQL) or "json" (file-based)
# Default: "database" (recommended for production)
STORAGE_BACKEND=database

# Database URL (used when STORAGE_BACKEND=database)
# SQLite: sqlite:///./rag_docqa.db
# PostgreSQL: postgresql://user:password@localhost/dbname
# MySQL: mysql+pymysql://user:password@localhost/dbname
DATABASE_URL=sqlite:///./rag_docqa.db

# Document/Conversation Storage (used when STORAGE_BACKEND=json)
VECTOR_STORE_PATH=./chroma_db
CONVERSATIONS_DIR=./conversations

# LLM Configuration
# Supported providers: openai, anthropic, cohere, local
LLM_PROVIDER=openai

# Model selection depends on provider:
# - openai: gpt-4, gpt-3.5-turbo, etc.
# - anthropic: claude-3-opus, claude-3-sonnet, claude-3-haiku, etc.
# - cohere: command, command-light, command-nightly, etc.
# - local: microsoft/DialoGPT-medium, etc. (HuggingFace model names)
LLM_MODEL=gpt-3.5-turbo

# API Keys (only required for your selected provider)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
COHERE_API_KEY=...

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# API Configuration
API_KEY_HEADER_NAME=X-API-Key
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_UPLOAD=20/hour
RATE_LIMIT_ASK=120/hour
RATE_LIMIT_READ=600/hour

# Logging
LOG_LEVEL=INFO

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=false

# API Documentation
ENABLE_API_DOCS=true
ENV=development

# Metrics
ENABLE_METRICS=true
METRICS_TOKEN=

# Audit Logging
AUDIT_LOG_ASK=false
